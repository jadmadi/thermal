#!/usr/bin/env bash
#
# Thermal Git Pre-Push Hook
# Executes comprehensive verification (full race detector, statement coverage,
# report card, binary build, and simulated user release gate) before remote push.
#
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
CHECK_SCRIPT="${REPO_ROOT}/scripts/check.sh"

if [ -x "${CHECK_SCRIPT}" ]; then
    exec "${CHECK_SCRIPT}" --pre-push
else
    echo "Warning: ${CHECK_SCRIPT} not found or not executable; skipping pre-push gate."
    exit 0
fi
