  "faq": [
    {
      "question": "How does Thermal collect data without a daemon or API keys?",
      "answer": "Thermal reads existing session JSON and SQLite databases that agents write locally (e.g. ~/.claude/, ~/.codex/, ~/.opencode/). It never makes outbound network calls during analysis."
    },
    {
      "question": "Does Thermal send telemetry or data to the cloud?",
      "answer": "No. Thermal operates on a strict zero-telemetry invariant. All analysis runs entirely offline on your local machine, and no database or background daemon is ever installed."
    },
    {
      "question": "How are token costs calculated?",
      "answer": "When tools record actual costs (like OpenCode, MiMoCode, and Grok), Thermal uses the exact recorded dollars. For tools that only record tokens and models, Thermal estimates cost using current rate cards from models.dev, clearly marking estimated values with a tilde (~)."
    },
    {
      "question": "How does project detection work?",
      "answer": "Thermal traverses recorded session directories up to the nearest git root, resolving symlinks to fold worktrees and subdirectories into unified project entities."
    },
    {
      "question": "What platforms and architectures are supported?",
      "answer": "Thermal provides cross-compiled, single-binary executables for Linux (amd64, arm64), macOS (Apple Silicon arm64, Intel amd64), and Windows (amd64)."
    }
  ]
