{
  "$schema": "https://jadmadi.net/schemas/project.schema.json",
  // Timestamp of the last metadata revision (Format: YY-MM-DD-HH-MM, e.g. 26-10-07-07-20)
  "lastEdit": "26-10-20-19-15",

  // Unique identifier matching the project URL slug on jadmadi.net (e.g. /project/<id>/)
  "id": "thermal",

  // Human-readable title
  "title": "Thermal",

  // Single-sentence punchy tagline
  "tagline": "Multi-agent terminal heatmap, token FinOps, and live burn monitor",

  // Semantic version (SemVer, e.g. "0.18.0", or CalVer, e.g. "2026.9.0")
  "version": "0.20.0",

  // 2-3 sentence executive summary explaining what it does, why it exists, and zero-bullshit proof
  "summary": "Local-first GitHub-style contribution heatmap and real-time terminal live monitor for 15 AI coding agents. Reads the local telemetry and session transcripts agents already wrote on disk, with zero cloud dependency and zero tracking.",

  // Status on catalog: "featured" | "active" | "in-progress" | "upstream-merged" | "beta" | "archived"
  "status": "featured",

  // Release or active year
  "year": "2026",

  // Technical stack breakdown
  "tech_stack": {
    "languages": [
      "Go",
      "SQLite"
    ],
    "frameworks": [
      "Bubble Tea (Charm)",
      "Lip Gloss"
    ],
    "architecture": "Single static binary, read-only SQLite mmap, bounded worker pools, delta snapshot caching, terminal-native live monitor",
    "license": "Dual: AGPL-3.0 (Community) / Commercial (Enterprise)",
    "license_type": "copyleft" // "permissive" | "copyleft" | "waqf" | "proprietary"
  },

  // One-line metrics/capabilities pill shown on cards and tables
  "stats": "15 AI Tools · FinOps · CLI & Live Monitor · AGPL-3.0 / Commercial $30",

  // Highlight badges displayed on project cards
  "badges": [
    "Go CLI / TUI",
    "15 AI Coding Tools",
    "Commercial Use $30/developer/year",
    "Token FinOps",
    "SLSA Level 3",
    "Zero Telemetry"
  ],

  // Primary 1-line installation snippet (shown in copyable terminal widget)
  "install_command": "curl -fsSL https://jadmadi.net/thermal/install.sh | sh",

  // Multi-platform install commands (optional)
  "install_commands": {
    "linux_macos": "curl -fsSL https://jadmadi.net/thermal/install.sh | sh",
    "go": "go install github.com/jadmadi/thermal/cmd/thermal@latest"
  },

  // Authoritative external links
  "links": {
    "github": "https://github.com/jadmadi/thermal",
    "website": "https://jadmadi.net/project/thermal",
    "docs": "https://github.com/jadmadi/thermal/blob/main/README.md",
    "package": "https://pkg.go.dev/github.com/jadmadi/thermal"
  },

  // Problem statement: What pain point does this solve?
  "problem_statement": "Developers using multiple AI coding agents (Devin, OpenCode, Codex, Claude Code, Grok, etc.) lack unified visibility into token expenditure, cost estimates, and daily coding activity across tools.",

  // Solution: How does this solve it?
  "solution": "An instant, zero-configuration CLI and terminal live monitor that scans local session logs in milliseconds, calculates unified token metrics, prices model usage, and renders heatmaps, charts, and live burn telemetry directly in the terminal.",

  // List of major capabilities and distinct features
  "features": [
    "Real-time Bubble Tea live monitor with carried-in baselines, one-second Peak/Rate buckets, metric-specific flame ceilings, normalized token/step ticker columns, and cost decisions",
    "Supports 15 agent harnesses: Devin, OpenCode, MiMoCode, Codex, Claude Code, Antigravity/Agy, command-code, codewhale, Droid, DeepSeek (DSH), Grok CLI, Muse, Nous Hermes, ZCode, and Zed",
    "Commercial Use License at $30 per developer per year for internal commercial use, with published terms and a certificate path; Enterprise & OEM terms are separate",
    "Unified cross-agent disjoint token accounting (input, output, reasoning, cache read/write) with recorded vs estimated cost breakdown via models.dev",
    "Reasoning Effort Telemetry: cognitive intensity breakdowns across low, medium, and high reasoning tiers",
    "Context & Setup Health Audit (thermal audit): repository AGENTS.md context tax, MCP server density, local tool database file-readability checks (SQLite integrity and mmap are not assessed), and custom path checks",
    "Live Monitor (thermal live): terminal-native zero-cloud token streaming with launch-relative session baselines and carried-in history separated from live bursts, one-second Peak/Rate buckets, metric-specific configurable flame ceilings, normalized token/step ticker columns with cost status and age/outlier markers, burst rollup with time/cost sorting and top spenders, today project/model rollups, velocity sparklines, and NDJSON export",
    "Instant Shell Statusline Helper (thermal statusline): prompt-composable terminal helper for tmux and shell statuslines",
    "Zero-telemetry, offline-first design using read-only SQLite mmap and delta snapshot caching (~/.cache/thermal/); measured latency evidence and scale limits in docs/PERFORMANCE.md",
    "Static daily, weekly, monthly, projects, models, mix, stats, and trend reports with JSON output",
    "Unified output formatting: explicit $/~$/—/≥$ cost markers, ≈ non-cost approximations, active-window labels, and consistent tool separators across reports and live",
    "Cross-surface reconciled totals: canonical daily recorded+estimated cost, explicit unclassified-token volume, costed-day denominators, and estimate-only model/mix labeling",
    "Platform-native application data directory discovery and cross-platform SQLite URI path normalization",
    "Global configuration overrides via ~/.config/thermal/thermal.config (INI/JSON) for custom tool and database paths"
  ],

  // Frequently Asked Questions (displayed on project subpage & Schema.org FAQPage)
  "faq": [
    {
      "question": "Does Thermal send my coding session data to the cloud?",
      "answer": "No. Thermal is 100% local-first and zero-telemetry. It parses only the local JSON session transcripts and SQLite databases already generated on your local disk by your installed agent tools."
    },
    {
      "question": "How do I install Thermal on Linux or macOS?",
      "answer": "You can install Thermal instantly via curl: `curl -fsSL https://jadmadi.net/thermal/install.sh | sh` or compile directly from Go source with `go install github.com/jadmadi/thermal/cmd/thermal@latest`. For a local checkout, run `./build.sh --install` to build the current platform, install into GOBIN (or GOPATH/bin), and verify that the resolved thermal points at the new binary."
    },
    {
      "question": "How does Thermal calculate costs for tools that do not record dollar spend?",
      "answer": "Thermal parses the model identifiers used in each session and applies real-time or cached pricing from models.dev list prices. Estimated costs are clearly marked with a `~` prefix."
    },
    {
      "question": "How much does the commercial license cost?",
      "answer": "The Commercial Use License is $30 per developer per 12-month term for internal commercial use. It excludes redistribution, embedding, hosted services, and SLAs; Enterprise & OEM terms are separate. Live pricing: https://thermal.jadmadi.net/pricing.html. Pay via PayPal at https://paypal.me/Madise/30 or request an invoice at contact@jadmadi.net. Full terms: COMMERCIAL-LICENSE.md."
    },
    {
      "question": "How do I upgrade Thermal to the latest version?",
      "answer": "Run `thermal upgrade` to automatically check for releases, download the matching binary for your platform, and perform an in-place atomic update. You can also run `go install github.com/jadmadi/thermal/cmd/thermal@latest`."
    }
  ]
}